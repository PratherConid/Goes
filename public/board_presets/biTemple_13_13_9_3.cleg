egr biTemple(number x, number y, number z, number d) {
  return multiProd(
    [rectB(x, y), lineB(z)],
    psUnion(
      [
        psBase(
          0,
          mkSel("(diff (more " + (d + 1) + " (deg lt 4)) (more " + d + " (deg lt 4)))")
        ),
        psBase(1, mkSel("(deg eq 1)"))
      ]
    )
  );
}

biTemple(13, 13, 9, 3);
