egr knightOrthoRectB(number w, number h, number g, number p) {
  egr b = rectB(w, h);
  quad{} s1 = selectQuad((("(rrmp " + p) + " (all quad))"), b);
  quad{} s2 = (selectQuad("(all quad)", b) - s1);
  return modify(
    [
      form(
        g,
        [mkFormSel("quadKnightForm", s1), mkFormSel("quadForm", s2)]
      )
    ],
    b
  );
}
knightOrthoRectB(6, 6, 4, 0.5);
