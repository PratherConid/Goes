bool shellCond(number mi, number ma, number[] coords) {
  number sum = 0;
  number l = len(coords);
  for (number i = 0; (i < l); i = (i + 1)) {
    sum = (sum + (coords[i] * coords[i]));
  }
  return ((sum >= (mi * mi)) && (sum <= (ma * ma)));
}
egr shellB(number r1, number r2, number dim) {
  number mi = r1;
  number ma = r2;
  if ((r1 > r2)) {
    mi = r2;
    ma = r1;
  }
  return subHcublatB(([[(-ma), ma]] * dim), shellCond(mi, ma, #));
}
egr extrude(number h, string seltype, egr b) {
  sel border = mkSel((("(conveq edge 1 (all " + seltype) + "))"));
  return multiProd(
    [b, lineB(h)],
    psUnion([psBase(0, border), psBase(1, {0, (h - 1)})])
  );
}
extrude(5, "quad", shellB(4, 9.5, 2));
